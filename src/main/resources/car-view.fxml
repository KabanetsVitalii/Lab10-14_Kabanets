<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="750" prefHeight="550" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CarController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Панель пошуку та фільтрації -->
    <HBox spacing="10">
        <ComboBox fx:id="fieldBox" prefWidth="120"/>
        <TextField fx:id="queryField" promptText="Значення для пошуку" HBox.hgrow="ALWAYS"/>
        <Button fx:id="searchBtn" text="Пошук" onAction="#searchCars"/>
        <Button fx:id="filterBtn" text="Фільтр" onAction="#filterCars"/>
        <Button fx:id="resetBtn" text="Всі" onAction="#refreshTable"/>
    </HBox>

    <!-- Таблиця даних -->
    <TableView fx:id="carTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colBrand" text="Марка" prefWidth="170"/>
            <TableColumn fx:id="colModel" text="Модель" prefWidth="170"/>
            <TableColumn fx:id="colYear" text="Рік" prefWidth="90"/>
        </columns>
    </TableView>

    <!-- Панель індикації та прогресу -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ProgressBar fx:id="progress" prefWidth="200" progress="0.0"/>
        <Button fx:id="validateBtn" text="Перевірити записи" onAction="#validateCars"/>
        <Button fx:id="cancelBtn" text="Скасувати" onAction="#cancelValidation"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="Готово"/>
    </HBox>

    <!-- Форма введення даних -->
    <HBox spacing="10">
        <TextField fx:id="brandField" promptText="Марка" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="modelField" promptText="Модель" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="yearField" promptText="Рік" prefWidth="90"/>
    </HBox>

    <!-- Панель CRUD кнопок -->
    <HBox spacing="10">
        <Button fx:id="addBtn" text="Додати" onAction="#handleAdd"/>
        <Button fx:id="updateBtn" text="Редагувати" onAction="#handleEdit"/>
        <Button fx:id="deleteBtn" text="Видалити" onAction="#handleDelete"/>
    </HBox>
</VBox>